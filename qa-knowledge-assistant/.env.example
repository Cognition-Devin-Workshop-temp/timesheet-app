# QA Knowledge Assistant Configuration
# Copy this file to .env and customize as needed

# LLM Provider: 'openai', 'azure_openai', or 'mock' (default, no API key needed)
QA_LLM_PROVIDER=mock

# OpenAI (if using openai provider)
QA_OPENAI_API_KEY=sk-your-key-here

# Azure OpenAI (if using azure_openai provider)
QA_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
QA_AZURE_OPENAI_API_KEY=your-key-here
QA_AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Embedding Configuration
QA_EMBEDDING_PROVIDER=mock
QA_EMBEDDING_MODEL=text-embedding-3-small
QA_EMBEDDING_DIMENSION=384

# ChromaDB
QA_CHROMA_PERSIST_DIR=./data/chroma
QA_CHROMA_COLLECTION_NAME=qa_knowledge

# Metadata Store
QA_METADATA_DB_PATH=./data/metadata.db

# Chunking
QA_CHUNK_SIZE=512
QA_CHUNK_OVERLAP=64

# Retrieval
QA_RETRIEVAL_TOP_K=10
QA_RERANK_TOP_K=5

# API Server
QA_API_HOST=0.0.0.0
QA_API_PORT=8000

# Logging
QA_LOG_LEVEL=INFO
