# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# JWT Configuration
# IMPORTANT: In production, JWT_SECRET MUST be at least 32 characters.
# The server will refuse to start in production without a valid secret.
# Generate one with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# CSRF Configuration
# IMPORTANT: Change in production
CSRF_SECRET=your-csrf-secret-change-in-production

# Database Configuration
# File-based SQLite (default: ./data/timesheet.db)
# Set to :memory: for in-memory database (data lost on restart)
DATABASE_PATH=./data/timesheet.db
